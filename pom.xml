<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>roshdeandishe</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>roshdeandishe</name>
    <description>School Management System - Modular Monolith</description>

    <properties>
        <java.version>21</java.version>
        <spring-modulith.version>2.0.0</spring-modulith.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- BOM مربوط به Spring Modulith برای هماهنگی نسخه‌ها -->
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web (شامل Thymeleaf-friendly MVC) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JTE برای صفحه‌ی فعال‌سازی حساب (اولین صفحه‌ی HTML واقعی پروژه) -->
        <dependency>
            <groupId>gg.jte</groupId>
            <artifactId>jte-spring-boot-starter-4</artifactId>
            <version>3.2.4</version>
        </dependency>

        <!-- Alpine.js و Bulma به‌صورت WebJar، هم‌راستا با الگوی موجود پروژه
             (springdoc از قبل org.webjars:swagger-ui را ترنزیتیو می‌آورد) -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>alpinejs</artifactId>
            <version>3.15.12</version>
        </dependency>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>bulma</artifactId>
            <version>1.0.4</version>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.2</version>
        </dependency>
        <!-- JPA / Hibernate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- PostgreSQL Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway - مالکِ schema از این پس (ddl-auto دیگر روی update نیست،
             روی validate است). نسخه‌ها توسط spring-boot-dependencies مدیریت
             می‌شوند. هر سه لازم‌اند و هیچ‌کدام اضافه نیست:
               * flyway-core: خود موتور مهاجرت.
               * flyway-database-postgresql: از Flyway 10 به بعد پشتیبانیِ هر
                 دیتابیس در ماژول جدای خودش است، وگرنه Flyway در زمان اجرا
                 Postgres را نمی‌شناسد.
               * spring-boot-flyway: در Spring Boot 4، autoconfiguration ها از
                 spring-boot-autoconfigure جدا شده و هر کدام artifact خودشان را
                 دارند. بدون این یکی، flyway-core در classpath هست ولی هیچ‌وقت
                 اجرا نمی‌شود و Hibernate با «missing table» بالا نمی‌آید -
                 یک شکستِ خاموش، نه خطای وابستگی. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- نشست وب در پستگرس، نه در heap این کانتینر. دو نتیجه‌ی مستقیم:
             دیپلوی و ری‌استارت دیگر همه را logout نمی‌کند، و حجم نشست‌ها
             دیگر یک سهمِ اندازه‌گیری‌نشده از حافظه‌ی کانتینر نیست.
             نسخه را spring-boot-dependencies مدیریت می‌کند (4.1.0).

             این تغییر اپ را «چند-instance» نمی‌کند: دو job زمان‌بندی‌شده
             (EventReminderJob و AcademicYearProvisioner) هیچ محافظی برای
             اجرای هم‌زمان روی چند instance ندارند - رجوع به
             openspec/changes/jdbc-backed-web-sessions.md

             *starter* است و نه org.springframework.session:spring-session-jdbc
             خالی، به همان دلیلی که بالاتر برای flyway نوشته شده: در Spring
             Boot 4 هر autoconfiguration artifact خودش را دارد
             (spring-boot-session-jdbc). با وابستگیِ خالی، کتابخانه در
             classpath هست ولی هیچ‌وقت wire نمی‌شود - نشست بی‌صدا در حافظه
             می‌ماند و هیچ خطایی هم نمی‌دهد. این حالت آزموده شد: لاگین ۲۰۰
             می‌داد و iam.spring_session صفر ردیف داشت. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-session-jdbc</artifactId>
        </dependency>

        <!-- Security (برای IAM ماژول) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- JWT برای احراز هویت موبایل (additive به session، نه جایگزین آن) -
             هیچ BOM ای برای JJWT در dependencyManagement موجود نیست، پس نسخه
             صریح pin می‌شود. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Jackson 2، صریح و مستقیم. چهار کلاس تولیدی مستقیماً از آن import
             می‌کنند: notification/internal/BaleClient، BaleUpdate، BaleWebhookService و
             studyplan/internal/StudyPlanFacadeImpl. علتش در کامنت داخل
             StudyPlanFacadeImpl آمده - با حضور Jackson 3 روی classpath، اسپرینگ
             بوت ۴ دیگر یک Bean واحد از com.fasterxml.jackson.databind.ObjectMapper
             نمی‌سازد، پس آن کلاس‌ها ObjectMapper خودشان را می‌سازند.

             تا پیش از این، این وابستگی فقط ترنزیتیو می‌آمد و تنها مسیرِ
             compile اش springdoc بود؛ jjwt-jackson هم آن را می‌آورد ولی با
             scope=runtime، که برای کامپایل به کار نمی‌آید. یعنی حذف springdoc
             (که یک بار آزموده شد) کامپایل را با «package com.fasterxml.jackson.databind
             does not exist» می‌شکست - شکستی که هیچ ربطی به چهار کلاس بالا
             نداشت و هیچ هشداری هم از قبل نمی‌داد.

             نسخه عمداً pin نشده: spring-boot-dependencies همین حالا هم آن را
             مدیریت می‌کند (۲.۲۱.۴)، و pin کردن دستی یعنی جا ماندن از ارتقای
             بوت. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Mail (ارسال ایمیل لینک فعال‌سازی حساب - iam/internal/InviteEmailSender) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- AOP (برای @RequiresModule) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- Spring Modulith Core + Events API -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>

        <!-- ثبت رویدادهای منتشر شده در دیتابیس (برای Async reliability) -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-jpa</artifactId>
        </dependency>

        <!-- Actuator. تا پیش از استقرار واقعی، فقط spring-modulith-actuator
             اینجا بود؛ آن وابستگی صرفاً jar خودِ spring-boot-actuator را
             ترنزیتیو می‌آورد، نه spring-boot-actuator-autoconfigure را - یعنی
             هیچ endpointای هرگز map نمی‌شد و کل بلوک management در
             application.yml (exposure: health, info, modulith) بی‌اثر بود:
             /actuator/health همیشه 404 می‌داد. با استقرار روی لیارا این دیگر
             بی‌اهمیت نیست - healthCheck در liara.json دقیقاً همین مسیر را
             صدا می‌زند و بدون آن هر دیپلوی ناسالم علامت می‌خورد. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- پشتیبانی از ActuatorObservability ماژول‌ها (اختیاری ولی توصیه‌شده) -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-actuator</artifactId>
        </dependency>

        <!-- Lombok برای کاهش Boilerplate در Entityها -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- تولید خودکار مستندات معماری (دیاگرام C4/PlantUML + Module Canvas)
             از روی همان مدل ماژولی که ModularityTests تأیید می‌کند -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-docs</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- SMTP سرور درون-تستی برای راستی‌آزمایی ارسال واقعی ایمیل دعوت -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail-junit5</artifactId>
            <version>2.1.3</version>
            <scope>test</scope>
        </dependency>
        <!-- انتظار برای listenerهای async ماژولیت (ثبت‌نام → فاکتور) در تست‌ها -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MockMvc در Boot 4 به ماژول تست جداگانه‌ی webmvc منتقل شده -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>gg.jte</groupId>
                <artifactId>jte-maven-plugin</artifactId>
                <version>3.2.4</version>
                <configuration>
                    <sourceDirectory>${project.basedir}/src/main/jte</sourceDirectory>
                    <contentType>Html</contentType>
                </configuration>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
