{
  "app": "roshdeandishe",
  "platform": "docker",
  "port": 8080,
  "timezone": "Asia/Tehran",
  "build": {
    "location": "germany",
    "cache": true,
    "dockerfile": "./Dockerfile"
  },
  "healthCheck": {
    "command": "CMD curl --fail http://localhost:8080/actuator/health || exit 1",
    "interval": 30,
    "timeout": 10,
    "retries": 3,
    "startPeriod": 90
  }
}
